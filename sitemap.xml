<?xml version="1.0" encoding="UTF-8"?>
<!--
  Situs ini pakai hash routing (#/zona, #/berita, dst) sehingga bagi Google
  semua "halaman" adalah URL yang sama (root). Sitemap ini sengaja cuma
  berisi 1 URL agar akurat -- menambah #/zona dkk di sini TIDAK akan membuat
  Google meng-index-nya sebagai halaman terpisah.
  Ganti https://YOUR-DOMAIN.example/ dengan domain produksi asli.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://YOUR-DOMAIN.example/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
